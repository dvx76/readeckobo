server:
  port: 8080
  # Optional: directory for the server state store (kepub cache, annotation
  # ledger). Defaults to "data" when omitted.
  # data_dir: data
log_level: info
readeck:
  host: "https://your-readeck-instance.com"
users:
  - token: "a-very-secret-token-for-your-kobo"
    readeck_access_token: "your-plain-text-readeck-access-token"
